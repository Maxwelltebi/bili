# Server-side only. Never prefix an API key with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
API_PORT=3001
# Server-side Supabase Data API (apply supabase/migrations first).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Optional stable signing secret for demo sessions. Defaults to the server's
# Supabase secret; changing that default signs this browser into a fresh demo.
SESSION_SECRET=
